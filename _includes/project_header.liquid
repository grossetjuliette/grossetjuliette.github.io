{% comment %}
  Paper-style header for a project page.
  Reads from the page front matter:
    venue    - short venue / context line shown as an eyebrow above the title
    authors  - list of { name, url }, the entry for Juliette is marked with `me: true`
    links    - list of { label, url, icon } rendered as buttons
    tags     - list of strings
{% endcomment %}

<div class="project-header">
  {% if page.venue %}
    <p class="project-eyebrow">{{ page.venue }}</p>
  {% endif %}

  {% if page.authors %}
    <p class="project-authors">
      {% for author in page.authors %}
        {%- if author.url -%}
          <a
            href="{{ author.url }}"
            {% if author.me %}
              class="me"
            {% endif %}
          >
            {{- author.name -}}
          </a>
        {%- else -%}
          <span
            {% if author.me %}
              class="me"
            {% endif %}
          >
            {{- author.name -}}
          </span>
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {% endfor %}
    </p>
  {% endif %}

  {% if page.affiliations %}
    <p class="project-affiliations">{{ page.affiliations | join: ' · ' }}</p>
  {% endif %}

  {% if page.links %}
    <p class="project-links">
      {% for link in page.links %}
        <a href="{{ link.url }}" class="btn btn-sm z-depth-0" role="button">
          {% if link.icon %}<i class="{{ link.icon }}"></i> {% endif -%}
          {{- link.label }}
        </a>
      {% endfor %}
    </p>
  {% endif %}

  {% if page.tags %}
    <p class="project-tags">
      {% for tag in page.tags -%}
        <span class="project-tag">{{ tag }}</span>
      {%- endfor %}
    </p>
  {% endif %}
</div>
