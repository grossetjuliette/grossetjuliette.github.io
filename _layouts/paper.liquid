---
layout: default
---
{% comment %}
  Project / paper page modelled on the IRL CROSSING resource pages:
  hero (back link, venue chip, title, authors with affiliation numbers, link pills),
  the page body, and a sticky sidebar with links, tags and a table of contents
  built from the body's h2 headings.
  Front matter: venue, authors [{name, url, me, aff: [1, 2]}], affiliations, links [{label, url, icon}], tags.
{% endcomment %}

<div class="paper-page">
  <div class="paper-main">
    <header class="paper-hero">
      <div class="paper-meta">
        <a class="paper-back" href="{{ '/projects/' | relative_url }}"
          ><i class="fa-solid fa-arrow-left"></i> {% include t.liquid en="All projects" fr="Tous les projets" -%}
        </a>
        {% if page.venue -%}
          <span class="paper-chip">{% include t.liquid en=page.venue fr=page.venue_fr %}</span>
        {%- endif %}
      </div>

      <h1 class="paper-title">
        {% assign pt = page.paper_title | default: page.title -%}
        {%- assign pt_fr = page.paper_title_fr | default: page.title_fr | default: pt -%}
        {%- include t.liquid en=pt fr=pt_fr %}
      </h1>

      {% if page.authors %}
        <p class="paper-authors">
          {% for author in page.authors -%}
            {%- if author.url -%}
              <a
                href="{{ author.url }}"
                {% if author.me %}
                  class="me"
                {% endif %}
              >
                {{- author.name -}}
              </a>
            {%- else -%}
              <span
                {% if author.me %}
                  class="me"
                {% endif %}
              >
                {{- author.name -}}
              </span>
            {%- endif -%}
            {%- if author.aff -%}
              <sup>{{ author.aff | join: ',' }}</sup>
            {%- endif -%}
            {%- unless forloop.last %}, {% endunless -%}
          {%- endfor %}
        </p>
      {% endif %}

      {% if page.affiliations %}
        <p class="paper-affiliations">
          {% for aff in page.affiliations -%}
            {%- if page.authors[0].aff -%}
              <sup>{{ forloop.index }}</sup>
            {%- endif -%}
            {{- aff }}
            {%- unless forloop.last %} · {% endunless -%}
          {%- endfor %}
        </p>
      {% endif %}

      {% if page.links %}
        <div class="paper-links">
          {% for link in page.links %}
            <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
              {% if link.icon %}<i class="{{ link.icon }}"></i>{% endif %}
              {% include t.liquid en=link.label fr=link.label_fr %}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </header>

    <article class="paper-body">
      {{ content }}
    </article>

    {% if page.related_publications %}
      <h2 id="references">References</h2>
      <div class="publications">
        {% bibliography --cited_in_order %}
      </div>
    {% endif %}
  </div>

  <aside class="paper-aside">
    {% if page.links %}
      <div class="paper-card">
        <p class="paper-card-title">{% include t.liquid en="Links" fr="Liens" %}</p>
        {% for link in page.links %}
          <a class="paper-side-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
            {% if link.icon %}<i class="{{ link.icon }}"></i>{% endif %}
            {% include t.liquid en=link.label fr=link.label_fr %}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if page.tags %}
      <div class="paper-card">
        <p class="paper-card-title">{% include t.liquid en="Tags" fr="Mots-clés" %}</p>
        <div class="paper-tags">
          {% for tag in page.tags -%}
            <span class="lang-en">{{ tag }}</span>
          {%- endfor %}
          {% assign tags_fr = page.tags_fr | default: page.tags %}
          {% for tag in tags_fr -%}
            <span class="lang-fr">{{ tag }}</span>
          {%- endfor %}
        </div>
      </div>
    {% endif %}

    <div class="paper-card">
      <p class="paper-card-title">{% include t.liquid en="Table of contents" fr="Sommaire" %}</p>
      <nav class="paper-toc" id="paper-toc"></nav>
    </div>
  </aside>
</div>

<script src="{{ '/assets/js/section-toc.js' | relative_url | bust_file_cache }}"></script>
<script>
  buildSectionToc(document.getElementById('paper-toc'), '.paper-body h2, .paper-main > h2', true);
</script>
