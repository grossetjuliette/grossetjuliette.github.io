---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{% include t.liquid en=page.title fr=page.title_fr %}</h1>
    <p class="post-description">{% include t.liquid en=page.description fr=page.description_fr %}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% unless page.side_toc == false %}
    {% include side_toc.liquid scope=".post article" %}
  {% endunless %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
